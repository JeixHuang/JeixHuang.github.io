{{- $pages := partial "blog-index-posts.html" . -}}
{{- $pages = sort $pages "Date" "desc" -}}
[
{{- range $i, $p := $pages -}}
  {{- if $i }},{{ end }}
  {{- $excerpt := (or $p.Params.tldr $p.Params.summary $p.Summary) | plainify | htmlUnescape | replaceRE "\\s+" " " | strings.TrimSpace | truncate 160 -}}
  {
    "title": {{ $p.Title | jsonify }},
    "date": {{ $p.Date.Format "2006-01-02" | jsonify }},
    "url": {{ $p.RelPermalink | jsonify }},
    "excerpt": {{ $excerpt | jsonify }},
    "language": {{ or $p.Params.content_lang $p.Site.Language.Lang | jsonify }},
    "translationKey": {{ $p.Params.translationKey | jsonify }},
    "weekly_report": {{ default false $p.Params.weekly_report | jsonify }}
  }
{{- end -}}
]
